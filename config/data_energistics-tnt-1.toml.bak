#Chunk-flattening TNT settings.
#Chunk radius uses the center chunk as 0. Example: 1 = 3x3 chunks, 2 = 5x5 chunks.
[flatteningTnt]

	#Settings for the reserved configurable TNT block.
	[flatteningTnt.tntConfigurable]
		#Chunk radius for the cleared area. 1 = 3x3 chunks.
		# Default: 1
		# Range: 0 ~ 64
		clearChunkRadius = 1
		#Vertical offset from the TNT position where clearing starts.
		# Default: 0
		# Range: -384 ~ 384
		clearStartYOffset = 0
		#Number of vertical blocks to clear.
		# Default: 25
		# Range: 1 ~ 512
		clearHeight = 25
		#Chunk radius for the filled floor area. 1 = 3x3 chunks.
		# Default: 1
		# Range: 0 ~ 64
		fillChunkRadius = 1
		#Vertical offset from the TNT position for the filled floor layer.
		# Default: -1
		# Range: -384 ~ 384
		fillYOffset = -1
		#Block id used for the filled floor layer.
		fillBlock = "minecraft:dirt"
		#X offset applied to the TNT position before calculating clear/fill areas.
		# Default: 0
		# Range: -512 ~ 512
		centerOffsetX = 0
		#Y offset applied to the TNT position before calculating clear/fill areas.
		# Default: 0
		# Range: -512 ~ 512
		centerOffsetY = 0
		#Z offset applied to the TNT position before calculating clear/fill areas.
		# Default: 0
		# Range: -512 ~ 512
		centerOffsetZ = 0
		#If true, water/lava blocks are not removed by the clearing step.
		preserveFluids = false
		#If true, blocks with negative destroy time can still be removed/replaced.
		replaceUnbreakableBlocks = false
		#Display name shown for the configurable TNT item.
		displayName = "自定义平地TNT"
