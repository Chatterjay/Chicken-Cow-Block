#Base power cost for the data ripper power curve.
# Default: 512
# Range: > 1
dataRipperBaseCost = 512
#Regex patterns for block ids that the data ripper should never accelerate.
dataRipperBlacklist = []
#Regex-based power multipliers for the data ripper, formatted as pattern=value.
dataRipperMultipliers = []
#Base chunk coverage level for the Data Distribution Tower. 1=1x1 chunk, 2=3x3 chunks, etc.
# Default: 1
# Range: 1 ~ 128
dataDistributionTowerRange = 1
#Maximum FE transferred per tick by a Data Distribution Tower network.
# Default: 9223372036854775807
# Range: 1 ~ 9223372036854775807
dataDistributionTowerTransferPerTick = 2147483647
#Base stocked item amount per Data Sanctum interface config/stock slot. Each capacity card doubles this value.
# Default: 2048
# Range: 1 ~ 268435455
dataSanctumInterfaceItemLimit = 8192
#Base stocked fluid buckets per Data Sanctum interface config/stock slot. Each capacity card doubles this value.
# Default: 2048
# Range: 1 ~ 268435455
dataSanctumInterfaceFluidBuckets = 512
#Base item amount per Data Sanctum interface return slot. Each capacity card doubles this value.
# Default: 2048
# Range: 1 ~ 268435455
dataSanctumInterfaceReturnItemLimit = 65536
#Base fluid buckets per Data Sanctum interface return slot. Each capacity card doubles this value.
# Default: 2048
# Range: 1 ~ 268435455
dataSanctumInterfaceReturnFluidBuckets = 4096
