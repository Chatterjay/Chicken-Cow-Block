	chapter_group.776C6CE13442DD6F.title: "资源生产"
	quest.09DCCF660252EC56.quest_desc: [
		"&e独特的生命和魔法的力量让你的思维更上一层楼。"
		"至此前期正式结束，几乎所有的基础矿物都可以自动生产，接下来就是属于你的创造时间。"
	]
	quest.0EE7DE1B0C34AFE0.quest_desc: ["身为科鸡魔族的一员，你非常了解如何将动力最大化。"]
	quest.10CC6D135FAB580D.quest_desc: ["拿圆石右键牛，牛会转化为熔岩流体牛，拿桶右键即可获取对应流体桶"]
	quest.1548BC8A104FA59E.quest_desc: ["你看着从天而降（从地里钻出来）的家伙，感觉莫名其妙，但你也感觉他能给予你足够的帮助"]
	quest.155883D1877A2719.quest_desc: ["你看着出现在眼前的牛，心中的愤怒涌了上来。但你还没有动作，它却有了反应，朝你冲了过来，口中还喊着为什么摧毁了我的文明。你意识到了不对，为其解释了一番，它最终选择了帮助你去探寻最终的答案。"]
	quest.18EA04131837A01F.quest_desc: ["蹲起可以让草方块上长出草，所以这个你应该知道如何获得。"]
	quest.247DCC5ECC679756.quest_desc: ["地狱也跟主世界一样是空岛，但保留了地狱的各种建筑"]
	quest.27D545DA7CC1A96F.quest_desc: ["整合包添加了棕色染料的全新配方"]
	quest.28F70CAC1A12B42C.quest_desc: ["&e你看着身上的同类，陷入了沉思。他没有思考与说话的能力，却给你带来了活下去的方法。你不知道为何会这样，但你却有了活下去的动力，想要去探明一切。"]
	quest.299820BFFE3B26AB.quest_desc: ["杀死鸡的时候有概率会生成一只羽毛鸡"]
	quest.31711BFA792A77A3.quest_desc: ["有了它你就可以增加鸡的产量了"]
	quest.33940470EC6FBE64.quest_desc: [
		"&4你醒来了"
		"  &e你望着远处的虚空，又看看了看脚下的土地，不知是真是假。最近的记忆停留在了Chicken文明被抹去的那一刻，以及你在晕倒前看到了似乎是牛的身影？"
		"  身为的科鸡魔族的一员，你下定决心一定要为自己的文明报仇。"
	]
	quest.33940470EC6FBE64.title: "开篇剧情"
	quest.346D5CD407FB2415.quest_desc: [
		"&e鸣谢名单"
		"1.&zKuDikan "
		"2. 艾特"
		"3. fish_旦"
	]
	quest.346D5CD407FB2415.title: "感谢在整合包制作过程中提供帮助的一些人"
	quest.3746C44DE7E402D7.quest_desc: ["整合包中只要丢出对应的鸡蛋必定会出对应的染料鸡。(妈妈再也不担心我脸黑了）"]
	quest.40A17507739AF9FC.quest_desc: ["本整合包是以养鸡和养牛为主题的水槽包，鸡主要生产物品，牛用来生产流体。"]
	quest.40A17507739AF9FC.title: "主题介绍"
	quest.4626FD5BD2974623.quest_desc: ["拿橡树树叶右键牛，牛会转化为水流体牛，拿桶右键即可获取对应流体桶"]
	quest.4BD2B6D5F311DB73.quest_desc: ["不知为何异界之人似乎不太喜欢黑色，每当有白色进入，它们就会占为己有并将黑色丢出自己的世界之外。"]
	quest.52CB86BBE4ADFDF5.quest_desc: ["通过堆肥桶获得骨粉。"]
	quest.53C3A1C3FB3BC9D2.quest_desc: ["跟沙砾鸡同理，用锤杀死沙砾鸡掉落沙子鸡"]
	quest.57956E9363663468.quest_desc: ["这全新的食物，让你想起了许多机器的细节"]
	quest.60D08C321417904A.quest_desc: ["&4重要提醒：千万不要把两只鸡都变成鸡灵魂"]
	quest.66F45042F3648B17.quest_desc: ["用魔法使模组的锤杀死圆石鸡会掉落沙砾鸡"]
	quest.6DCEBADBB83217F2.quest_desc: [
		" &e你看着周围空空如也的土地，你笑了。你嘲笑了刚刚自己的冲动，内心也渐渐被绝望所包裹。你看着无边无际的虚空，突然觉得Chicken文明在自己这结束也不错，至少它还多活了一段时间。想到这里。你没有犹豫一跃而下。"
		" &4跳入虚空，获得橡木鸡。"
	]
	quest.6E8497B508C4D49A.quest_desc: [
		"在这里我先感谢各位游玩我的整合包，真的真的非常感谢。"
		"由于这是我的第一个整合包，所以在各个方面都有存在不足，我非常欢迎大家在游玩的过程中找到问题并向我反馈。"
		"最后说一句，由于作者本人只是一个fw大一学生，空闲时间可能不是很多，如果有很多问题没有及时的解决，请大家见谅。"
	]
	quest.6E8497B508C4D49A.title: "作者的一些话"
	quest.759F09209F874236.quest_desc: ["&4鸡饲料可以种植！！！！！"]
	quest.759F09209F874236.title: "记住鸡饲料可以种植"
	quest.7A0DC4210630C3CE.quest_desc: ["圆石鸡由灰鸡和黑鸡杂交而来"]
}
